[Unit]
Description=Claude Telegram Bot
After=network.target

[Service]
Type=simple
User=%YOUR_USERNAME%
WorkingDirectory=/home/jyw/workspace/claude-code-telegram
Environment="PATH=/home/jyw/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/jyw/.local/bin/uv run claude-telegram-bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
